  const btnConfirmCancel = $('#btnConfirmCancel');
  const btnConfirmOk = $('#btnConfirmOk');

  btnConfirmCancel.addEventListener('click', () => {
    deleteTargetId = null;
    confirmModalBg.style.display = 'none';
  });

  btnConfirmOk.addEventListener('click', () => {
    if (deleteTargetId) {
      if(editingId === deleteTargetId) cancelEdit();
      notices = notices.filter(n => String(n.id) !== deleteTargetId);
      save(); renderAdminList();
      showToast('Notice deleted.', 'success');
      if(codeBox.classList.contains('show')) buildCode();
    }
    deleteTargetId = null;
    confirmModalBg.style.display = 'none';
  });

  function renderAdminList() {
    countTag.textContent = notices.length;
    if (notices.length === 0) {
      noticeList.innerHTML = '<div class="empty-state" style="color:var(--muted); font-size:0.85rem; text-align:center; padding:14px;">Nothing published.</div>';
      return;
    }
    noticeList.innerHTML = notices.map(n => `
      <div class="notice-item">
        <div class="meta"><span class="tag ${n.priority}" style="${priorityTagStyle(n)}">${esc(priorityTagLabel(n))}</span><span class="date">${fmtDate(n.ts)}</span></div>
        <div class="ttl" style="font-weight:bold; color:var(--blue); margin: 4px 0;">${esc(n.title)}</div>
        <div class="body">${n.html}</div>
        <div class="notice-actions">
          <button type="button" class="notice-edit" data-id="${n.id}">✏️ Edit notice</button>
          <button type="button" class="notice-del" data-id="${n.id}">🗑 Delete</button>
        </div>
      </div>`).join('');

    noticeList.querySelectorAll('.notice-del').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        deleteTargetId = btn.dataset.id;
        confirmModalBg.style.display = 'flex';
      });
    });

    noticeList.querySelectorAll('.notice-edit').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        startEdit(btn.dataset.id);
      });
    });
  }

  renderAdminList();
  
  let savedXPercent = 85;
  let savedYPercent = 85;
})();
</script>
</div>
</body>
</html>