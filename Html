<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>Notice System — Owner App</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800&family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');

  :root{
    --bg-deep:#030d1f;
    --bg-mid:#071b3a;
    --panel:#0a1f42;
    --line:rgba(96,214,255,.25);
    --text:#eaf5ff;
    --muted:#8fb0cc;
    --blue:#39c9ff;
    --amber:#ffbb4d;
    --green:#2ee88a;
    --red:#ff4d6a;
  }
  
  /* Isolated CSS Reset to guard against Blogger parent theme overrides */
  #ns-admin-scope, #ns-admin-scope * {
    box-sizing: border-box;
    font-family: 'Inter', sans-serif;
  }
  
  body {
    margin: 0; padding: 0;
    background-color: #030d1f;
  }
  
  /* Transforms the Admin Panel into a sleek, floating "Software Terminal" inside Blogger */
  #ns-admin-scope {
    background:
      radial-gradient(circle at 15% 0%, rgba(57,201,255,.14), transparent 45%),
      radial-gradient(circle at 90% 20%, rgba(46,232,138,.08), transparent 40%),
      var(--bg-deep) !important;
    color: var(--text) !important;
    margin: 24px auto !important;
    max-width: 720px !important;
    min-height: 85vh;
    border-radius: 16px !important;
    border: 1px solid var(--line) !important;
    box-shadow: 0 15px 50px rgba(0,0,0,0.5) !important;
    position: relative !important;
    padding-bottom: 50px;
  }

  /* Cyber Toast Notification Container */
  #toast-container {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100000;
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 90%;
    max-width: 400px;
    pointer-events: none;
  }
  .toast {
    background: #051530;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 12px 16px;
    color: var(--text);
    font-size: 0.88rem;
    font-weight: 600;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5), 0 0 15px rgba(57,201,255,0.15);
    display: flex;
    align-items: center;
    gap: 10px;
    transform: translateY(-20px);
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    pointer-events: auto;
  }
  .toast.show { transform: translateY(0); opacity: 1; }
  .toast-icon { font-size: 1.1rem; flex-shrink: 0; }
  .toast.success { border-color: var(--green); box-shadow: 0 0 15px rgba(46,232,138,0.2); }
  .toast.success .toast-icon { color: var(--green); }
  .toast.warning { border-color: var(--amber); box-shadow: 0 0 15px rgba(255,187,77,0.2); }
  .toast.warning .toast-icon { color: var(--amber); }

  #ns-admin-scope header{
    position:sticky; top:0; z-index:40;
    background:linear-gradient(180deg, #051530, rgba(5,21,48,.92));
    border-bottom:1px solid var(--line);
    padding:14px 16px; display:flex; align-items:center; gap:12px;
    backdrop-filter:blur(6px);
    border-radius: 16px 16px 0 0 !important;
  }
  .logo{
    width:42px; height:42px; flex:none; border-radius:50%;
    background:radial-gradient(circle at 30% 25%, #b9f3ff, var(--blue) 55%, #0a3a63 100%);
    box-shadow:0 0 14px rgba(57,201,255,.55);
    display:flex; align-items:center; justify-content:center;
  }
  .logo svg{width:24px;height:24px;}
  .brand h1{
    font-family:'Orbitron', sans-serif; font-weight:800; font-size:1.05rem;
    margin:0; letter-spacing:0.5px; color:#fff;
  }
  .brand span{
    display:block; font-family:'Space Mono', monospace; font-size:0.63rem;
    color:var(--muted); letter-spacing:1.2px; text-transform:uppercase; margin-top:2px;
  }

  main{max-width:640px; margin:0 auto; padding:18px 14px 0;}

  .card{
    background:var(--panel) !important;
    border:1px solid var(--line) !important;
    border-radius:16px !important;
    padding:18px 16px !important;
    margin-bottom:18px !important;
    box-shadow:0 8px 24px rgba(0,0,0,.35) !important;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .card h2{
    font-family:'Orbitron', sans-serif !important; font-size:0.92rem !important; font-weight:700 !important;
    margin:0 0 14px !important; color:var(--blue) !important; letter-spacing:0.4px !important;
    display:flex !important; align-items:center !important; justify-content:space-between !important;
  }
  .card h2 .count{
    font-family:'Space Mono', monospace !important; font-size:0.65rem !important; font-weight:400 !important;
    background:rgba(57,201,255,.12) !important; color:var(--blue) !important; padding:3px 8px !important; border-radius:20px !important;
  }

  label.field{display:block; margin-bottom:12px;}
  label.field .lbl{
    display:block; font-size:0.7rem; color:var(--muted); margin-bottom:5px;
    text-transform:uppercase; letter-spacing:0.6px; font-weight:600;
  }
  input[type=text], input[type=url]{
    width:100%; background:rgba(3,13,31,.7) !important; border:1px solid var(--line) !important;
    color:var(--text) !important; padding:10px 11px !important; border-radius:9px !important; font-size:0.93rem !important;
  }
  input[type=color]{
    width:100%; min-height:42px; background:rgba(3,13,31,.7) !important; border:1px solid var(--line) !important;
    border-radius:9px !important; padding:4px !important; cursor:pointer;
  }
  textarea.field-area {
    width:100%; background:rgba(3,13,31,.7) !important; border:1px solid var(--line) !important;
    color:var(--text) !important; padding:10px 11px !important; border-radius:9px !important; font-size:0.9rem !important;
    font-family:'Inter',sans-serif !important; resize: vertical; min-height: 120px;
  }
  input::placeholder{color:#5a7692;}

  select.pri{
    width:100%; background:rgba(3,13,31,.7) !important; border:1px solid var(--line) !important;
    color:var(--text) !important; padding:10px 11px !important; border-radius:9px !important; font-size:0.9rem !important;
  }

  .toolbar{display:flex; flex-wrap:wrap; gap:6px; margin-bottom:8px;}
  .toolbar button{
    border:1px solid var(--line) !important; background:rgba(57,201,255,.08) !important;
    color:var(--text) !important; font-size:0.82rem !important; padding:7px 10px !important; border-radius:8px !important;
    cursor:pointer; font-weight:600;
  }
  .toolbar button:active{transform:scale(0.94);}

  #editor, .terms-rich-editor{
    min-height:110px; background:rgba(3,13,31,.6) !important; border:1px solid var(--line) !important;
    border-radius:10px !important; padding:11px 12px !important; font-size:0.93rem !important; line-height:1.55 !important; outline:none !important;
    color: var(--text) !important;
  }
  #editor:empty:before{content:attr(data-placeholder); color:#5a7692;}
  .terms-rich-editor:empty:before{content:attr(data-placeholder); color:#5a7692;}
  
  #editor img, #editor video, .terms-rich-editor img, .terms-rich-editor video{max-width:100% !important; border-radius:8px !important; margin:6px 0 !important; display:block !important;}
  #editor mark, .terms-rich-editor mark{background:var(--amber) !important; color:#241500 !important; padding:0 2px !important; border-radius:3px !important;}
  #editor a, .terms-rich-editor a{color:var(--blue) !important; text-decoration:underline !important;}
  #editor hr, .terms-rich-editor hr{border:none; border-top:1px dashed var(--line); margin:12px 0;}
  #editor h3, .terms-rich-editor h3{font-family:'Orbitron', sans-serif; color:var(--blue); margin:10px 0 6px; font-size:1rem;}

  input[type=file]{display:none;}
  .row2{display:flex; gap:10px;}
  .row2 label.field{flex:1;}

  .btn{
    border:none !important; border-radius:10px !important; padding:11px 16px !important; font-weight:700 !important;
    font-size:0.9rem !important; cursor:pointer !important;
    display:inline-flex !important; align-items:center !important; justify-content:center !important; gap:7px !important;
    transition: opacity 0.2s ease, transform 0.1s ease !important;
  }
  .btn:disabled { opacity: 0.5 !important; cursor: not-allowed !important; }
  .btn:not(:disabled):active{transform:scale(0.97) !important;}
  .btn-primary{background:linear-gradient(180deg, #39c9ff, #1a8fc7) !important; color:#03142b !important; box-shadow:0 4px 12px rgba(57,201,255,.35) !important;}
  .btn-amber{background:linear-gradient(180deg, #ffbb4d, #d48e22) !important; color:#241500 !important; box-shadow:0 4px 12px rgba(255,187,77,.35) !important;}
  .btn-ghost{background:rgba(255,255,255,.06) !important; color:var(--text) !important; border:1px solid var(--line) !important;}
  .btn-full{width:100% !important;}
  .actions-row{display:flex; gap:10px; margin-top:14px; flex-wrap:wrap;}
  .actions-row .btn{flex:1; min-width:120px;}

  .load-overlay{display:none; align-items:center; justify-content:center; flex-direction:column; gap:10px; padding:24px 10px;}
  .load-overlay.show{display:flex;}
  .ring{width:48px; height:48px; border-radius:50%; border:3px solid rgba(57,201,255,.18); border-top-color:var(--blue); animation:spin .9s linear infinite;}
  @keyframes spin{to{transform:rotate(360deg);}}

  .setting-group {
    background: rgba(3,13,31,.45) !important;
    border: 1px dashed rgba(96,214,255,.15) !important;
    border-radius: 12px !important;
    padding: 14px !important;
    margin-top: 14px !important;
  }
  .setting-group-title {
    font-size: 0.72rem !important;
    font-family: 'Space Mono', monospace !important;
    color: var(--blue) !important;
    margin-bottom: 10px !important;
    text-transform: uppercase !important;
    font-weight: 700 !important;
  }

  .code-box{display:none; margin-top:14px;}
  .code-box.show{display:block;}
  .code-box textarea{
    width:100%; min-height:120px; resize:vertical; font-family:'Space Mono',monospace;
    font-size:0.68rem; line-height:1.4; background:#020814; color:#7fe8b3;
    border:1px solid var(--line); border-radius:10px; padding:12px;
  }
  .copy-confirm{font-size:0.78rem; color:var(--green); font-weight:700; margin-top:6px; display:none;}
  .copy-confirm.show{display:block;}

  .notice-item{
    background:rgba(3,13,31,.55) !important; border:1px solid var(--line) !important; border-radius:10px !important;
    padding:12px !important; margin-bottom:10px !important;
  }
  .notice-item .meta{display:flex; justify-content:space-between; align-items:center; margin-bottom:6px; gap:8px;}
  .tag{
    font-family:'Space Mono',monospace !important; font-size:0.62rem !important; padding:2px 8px !important; border-radius:20px !important;
    text-transform:uppercase !important; font-weight:700 !important;
  }
  .tag.standard{background:rgba(57,201,255,.14) !important; color:var(--blue) !important;}
  .tag.update{background:rgba(46,232,138,.14) !important; color:var(--green) !important;}
  .tag.alert{background:rgba(255,77,106,.16) !important; color:var(--red) !important;}
  .notice-item .date{font-family:'Space Mono',monospace !important; font-size:0.65rem !important; color:var(--muted) !important;}
  .notice-item .ttl{font-weight:700; margin-bottom:3px !important; color:var(--blue);}
  .notice-item .body{font-size:0.87rem !important; line-height:1.5 !important; color:var(--text) !important;}
  
  .notice-actions{display:flex; gap:12px; margin-top:10px;}
  .notice-edit{background:rgba(57,201,255,.1); border:1px solid var(--blue); color:var(--text); cursor:pointer; font-size:0.72rem; font-weight:700; padding:6px 12px; border-radius:6px; transition:all 0.2s;}
  .notice-edit:active{transform:scale(0.95);}
  .notice-del{background:rgba(255,77,106,.1); border:1px solid var(--red); color:var(--text); cursor:pointer; font-size:0.72rem; font-weight:700; padding:6px 12px; border-radius:6px; transition:all 0.2s;}
  .notice-del:active{transform:scale(0.95);}

  .modal-bg{display:none; position:fixed; inset:0; background:rgba(0,4,12,.78); z-index:100; align-items:flex-end; justify-content:center;}
  .modal-bg.show{display:flex;}
  .modal-sheet{background:#051530; width:100%; max-width:640px; max-height:88vh; overflow-y:auto; border-radius:20px 20px 0 0; padding:16px 14px 30px; border:1px solid var(--line); transition: max-width 0.2s ease-in-out;}
  .modal-head{display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;}
  .modal-head h3{margin:0; font-family:'Orbitron',sans-serif; font-size:0.95rem; color:#fff;}
  .modal-close{background:none;border:none;font-size:1.3rem;color:var(--muted);cursor:pointer;}

  #drag-setup-bubble {
    position: fixed; z-index: 10000; width: 56px; height: 56px; border-radius: 50%;
    border: 2px solid var(--amber); background: radial-gradient(circle at 30% 25%, #ffeb99, var(--amber) 55%, #633c00 100%);
    box-shadow: 0 0 20px rgba(255, 187, 77, 0.6); cursor: move; display: none; align-items: center; justify-content: center;
    touch-action: none;
  }
  #drag-setup-bubble.active { display: flex !important; }
  #drag-setup-bubble svg { width: 26px; height: 26px; pointer-events: none; }
  #drag-setup-bubble .coord-hint {
    position: absolute; bottom: -32px; background: rgba(0,0,0,0.85); border: 1px solid var(--amber);
    color: var(--amber); font-family: 'Space Mono', monospace; font-size: 0.6rem; padding: 2px 6px; border-radius: 4px; white-space: nowrap;
  }

  footer.hint{text-align:center; color:#5a7692; font-size:0.7rem; padding:20px 20px 0; line-height:1.6;}
  footer.hint b{color:var(--blue);}

  /* Global preview widget elements style definitions */
  .ns-wrap { font-family: Inter, sans-serif; color: #eaf5ff; }
  .ns-wrap .ns-head { font-family: Orbitron, sans-serif; font-weight: 700; font-size: 0.85rem; color: #39c9ff; margin-bottom: 10px; }
  .ns-wrap .ns-list { max-height: 400px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; }
  .ns-wrap .ns-card { background: #0a1f42; border: 1px solid rgba(96,214,255,.2); border-radius: 10px; padding: 12px; }
  .ns-wrap .ns-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px; }
  .ns-wrap .ns-tag { font-family: 'Space Mono', monospace; font-size: 0.6rem; padding: 2px 7px; border-radius: 20px; text-transform: uppercase; font-weight: 700; }
  .ns-wrap .ns-tag.standard { background: rgba(57,201,255,.16); color: #39c9ff; }
  .ns-wrap .ns-tag.update { background: rgba(46,232,138,.16); color: #2ee88a; }
  .ns-wrap .ns-tag.alert { background: rgba(255,77,106,.18); color: #ff4d6a; }
  .ns-wrap .ns-date { font-family: 'Space Mono', monospace; font-size: 0.63rem; color: #8fb0cc; }
  .ns-wrap .ns-title { font-weight: 700; font-size: 0.9rem; margin-bottom: 3px; }
  .ns-wrap .ns-body { font-size: 0.86rem; line-height: 1.5; color: #eaf5ff; }
  .ns-wrap .ns-body img, .ns-wrap .ns-body video { max-width: 100%; border-radius: 8px; margin-top: 6px; display: block; }
  .ns-wrap .ns-body a { color: #39c9ff; }
  .ns-wrap .ns-body mark { background: #ffbb4d; color: #241500; }
  .ns-wrap .ns-cta {
    display: inline-flex !important; align-items: center; justify-content: center; width: 100%; margin-top: 12px; padding: 10px 16px;
    background: linear-gradient(180deg, #39c9ff, #1a8fc7) !important; color: #03142b !important; border: none; border-radius: 8px;
    font-weight: 700; font-size: 0.85rem; text-transform: uppercase; box-shadow: 0 4px 12px rgba(57,201,255,.35); text-align: center;
  }

  .ns-terms-mount-class h3 {
    font-family: 'Orbitron', sans-serif !important; color: var(--blue) !important; font-weight: 800 !important;
    margin: 10px 0 6px !important; font-size: 1rem !important; display: block !important;
  }
  .ns-terms-mount-class img { max-width: 100% !important; border-radius: 8px !important; margin: 6px 0 !important; display: block !important; }
  .ns-terms-mount-class a { color: var(--blue) !important; text-decoration: underline !important; }
</style>
</head>
<body>

<div id="ns-admin-scope">
<div id="toast-container"></div>

<div class="modal-bg" id="confirmModalBg" style="display:none; position:fixed; inset:0; background:rgba(0,4,12,.85); z-index:110000; align-items:center; justify-content:center;">
  <div style="background:#051530; border:1px solid var(--line); border-radius:16px; padding:20px; width:90%; max-width:400px; box-shadow:0 10px 30px rgba(0,0,0,0.5);">
    <h3 style="margin:0 0 10px; font-family:'Orbitron',sans-serif; font-size:1rem; color:#fff;">⚠️ Confirmation</h3>
    <p style="margin:0 0 20px; font-size:0.88rem; color:var(--text); line-height:1.5;" id="confirmModalText">Are you sure you want to delete this notice?</p>
    <div style="display:flex; gap:10px; justify-content:flex-end;">
      <button type="button" class="btn btn-ghost" id="btnConfirmCancel" style="padding:8px 16px !important; font-size:0.8rem !important;">No, Cancel</button>
      <button type="button" class="btn btn-primary" id="btnConfirmOk" style="padding:8px 16px !important; font-size:0.8rem !important; background:linear-gradient(180deg, var(--red), #c71a3e) !important; color:#fff !important; box-shadow:0 4px 12px rgba(255,77,106,.35) !important;">Yes, Delete</button>
    </div>
  </div>
</div>

<div id="drag-setup-bubble" title="Drag to adjust default widget location">
  <svg viewBox="0 0 24 24" fill="none"><path d="M12 2.5c-1 0-1.8.8-1.8 1.8v.6C7.7 5.6 6 7.9 6 10.6v3.6L4.4 16.6c-.4.6 0 1.4.7 1.4h13.8c.7 0 1.1-.8.7-1.4L18 14.2v-3.6c0-2.7-1.7-5-4.2-5.7v-.6c0-1-.8-1.8-1.8-1.8Z" fill="#150a00"/><path d="M9.8 19a2.2 2.2 0 0 0 4.4 0Z" fill="#150a00"/></svg>
  <div class="coord-hint" id="dragCoordHint">Drag Me!</div>
</div>

<header>
  <div class="logo">
    <svg viewBox="0 0 24 24" fill="none"><path d="M12 2.5c-1 0-1.8.8-1.8 1.8v.6C7.7 5.6 6 7.9 6 10.6v3.6L4.4 16.6c-.4.6 0 1.4.7 1.4h13.8c.7 0 1.1-.8.7-1.4L18 14.2v-3.6c0-2.7-1.7-5-4.2-5.7v-.6c0-1-.8-1.8-1.8-1.8Z" fill="#03142b"/><path d="M9.8 19a2.2 2.2 0 0 0 4.4 0Z" fill="#03142b"/></svg>
  </div>
  <div class="brand">
    <h1>NOTICE SYSTEM</h1>
    <span>Owner App · protected mode</span>
  </div>
</header>

<main>
  <section class="card" id="composerCard">
    <h2 id="composerTitle">Compose a notice</h2>

    <div id="noticeFieldsBlock">
      <label class="field">
        <span class="lbl">Title</span>
        <input type="text" id="fTitle" placeholder="e.g. New chapter update">
      </label>

      <div class="row2">
        <label class="field">
          <span class="lbl">Priority</span>
          <select class="pri" id="fPriority">
            <option value="standard">Standard</option>
            <option value="update">Update</option>
            <option value="alert">Alert</option>
            <option value="custom">Custom panel tag</option>
          </select>
        </label>
      </div>

      <div class="row2" id="customPriorityBlock" style="display:none; margin-top:-4px;">
        <label class="field">
          <span class="lbl">Custom panel label</span>
          <input type="text" id="fCustomLabel" value="Custom" maxlength="30" placeholder="e.g. Event, Beta, Important">
        </label>
        <label class="field" style="max-width:170px;">
          <span class="lbl">Custom panel color</span>
          <input type="color" id="fCustomColor" value="#bb86fc" aria-label="Custom panel tag color">
        </label>
      </div>

      <div class="toolbar">
        <button type="button" id="btnBold"><b>B</b></button>
        <button type="button" id="btnHighlight">✏️ Highlight</button>
        <button type="button" id="btnLink">🔗 Link text</button>
        <button type="button" id="btnImg">🖼️ Image</button>
        <button type="button" id="btnVid">🎬 Video</button>
      </div>
      <div id="editor" contenteditable="true" data-placeholder="Write the notice…"></div>
      <input type="file" id="imgInput" accept="image/png, image/jpeg">

      <div class="row2" style="margin-top:12px;">
        <label class="field">
          <span class="lbl">Button link (optional)</span>
          <input type="url" id="fLink" placeholder="https://...">
        </label>
        <label class="field">
          <span class="lbl">Button label</span>
          <input type="text" id="fLinkLabel" placeholder="Learn more">
        </label>
      </div>
    </div>

    <div class="setting-group">
      <div class="setting-group-title">🎛️ Blogger Widget Placement & Styling</div>
      
      <div class="row2">
        <label class="field">
          <span class="lbl">Widget Display Style</span>
          <select class="pri" id="fWidgetMode">
            <option value="theme_panel">Theme Native Integration (Slide-Out Panel)</option>
            <option value="bubble">Floating Bubble (Draggable)</option>
            <option value="tab">Sleek Flat Side Tab</option>
            <option value="swipe">Invisible Swipe Edge (Mobile Gestures)</option>
            <option value="inline">Static Inline (Embed direct in page body)</option>
            <option value="modal">Mandatory Pop-up (Terms/Accept Checkbox)</option>
          </select>
        </label>
      </div>

      <div id="cfgBubbleBlock" class="row2" style="margin-top: 5px;">
        <label class="field">
          <span class="lbl">Snap Corner</span>
          <select class="pri" id="fCorner">
            <option value="bottom-right">Bottom-Right</option>
            <option value="bottom-left">Bottom-Left</option>
            <option value="top-right">Top-Right</option>
            <option value="top-left">Top-Left</option>
          </select>
        </label>
        <label class="field" style="max-width: 140px;">
          <button type="button" class="btn btn-ghost btn-full" id="btnStartDrag" style="margin-top: 15px; font-size: 0.8rem; padding: 10px;">🎯 Drag Setup</button>
        </label>
      </div>

      <div id="cfgTabBlock" class="row2" style="margin-top: 5px; display: none;">
        <label class="field">
          <span class="lbl">Tab Screen Side</span>
          <select class="pri" id="fTabSide">
            <option value="left">Left Screen Border</option>
            <option value="right">Right Screen Border</option>
          </select>
        </label>
        <label class="field">
          <span class="lbl">Tab Label</span>
          <input type="text" id="fTabText" value="📡 Notices">
        </label>
      </div>

      <div id="cfgSwipeBlock" class="row2" style="margin-top: 5px; display: none;">
        <label class="field">
          <span class="lbl">Swipe Detection Area</span>
          <select class="pri" id="fSwipeSide">
            <option value="left">Left Edge Swipe Inwards</option>
            <option value="right">Right Edge Swipe Inwards</option>
          </select>
        </label>
      </div>
      
      <div id="cfgModalBlock" style="margin-top: 5px; display: none; flex-direction: column;">
        <label class="field">
          <span class="lbl">Pop-up Header Text (Leave blank to remove)</span>
          <input type="text" id="fModalHeaderText" value="📡 IMPORTANT NOTICES">
        </label>

        <label class="field">
          <span class="lbl">Require Checkbox Agreement</span>
          <select class="pri" id="fModalCheckRequired">
            <option value="true">Yes, user must check checkbox to accept</option>
            <option value="false">No, just click continue button directly</option>
          </select>
        </label>

        <div>
          <span class="lbl" style="display:block; font-size:0.7rem; color:var(--muted); margin-bottom:5px; text-transform:uppercase; letter-spacing:0.6px; font-weight:600;">Disclaimer/Terms Body Content</span>
          <div class="toolbar" style="margin-bottom: 6px;">
            <button type="button" id="btnTermsH">H3 Header</button>
            <button type="button" id="btnTermsB"><b>B</b></button>
            <button type="button" id="btnTermsS"><del>S</del></button>
            <button type="button" id="btnTermsHR">― Divider Line</button>
            <button type="button" id="btnTermsLink">🔗 Link Text</button>
            <button type="button" id="btnTermsImg">🖼️ Image</button>
          </div>
          <div id="termsEditor" class="terms-rich-editor" contenteditable="true" data-placeholder="Write terms or welcome disclaimer details here..."></div>
          <input type="file" id="termsImgInput" accept="image/png, image/jpeg" style="display:none;">
        </div>

        <label class="field" style="margin-top:12px;">
          <span class="lbl">Pop-Up Max Width: <b id="lblWidthVal" style="color:var(--blue);">480px</b></span>
          <input type="range" id="fModalWidth" min="280" max="800" step="10" value="480" style="width:100%; accent-color:var(--blue); margin-top:4px;">
        </label>

        <label class="field" style="margin-top:8px;">
          <span class="lbl">Required Read Delay Timer: <b id="lblDelayVal" style="color:var(--amber);">0s (Instant)</b></span>
          <input type="range" id="fModalDelay" min="0" max="30" value="0" style="width:100%; accent-color:var(--amber); margin-top:4px;">
        </label>

        <div class="row2">
          <label class="field">
            <span class="lbl">Checkbox Agreement Text</span>
            <input type="text" id="fModalCheckText" value="I understand and accept">
          </label>
          <label class="field" style="max-width: 180px;">
            <span class="lbl">Accept Button Label</span>
            <input type="text" id="fModalBtnText" value="Continue">
          </label>
        </div>
      </div>
    </div>

    <div class="actions-row">
      <button type="button" class="btn btn-ghost" id="btnPreview">👁 Preview</button>
      <button type="button" class="btn btn-primary" id="btnPublish">📡 Publish</button>
      <button type="button" class="btn btn-ghost" id="btnCancelEdit" style="display:none; border-color:var(--red); color:var(--red);">✕ Cancel Edit</button>
    </div>

    <div class="load-overlay" id="loadOverlay">
      <div class="ring"></div>
      <p id="loadText">Publishing your notice…</p>
    </div>

    <div class="code-box" id="codeBox">
      <div id="codeBadge" style="font-family:'Orbitron',sans-serif; font-size:0.85rem; color:var(--green); margin-bottom:4px;">Published ✓ — code below</div>
      <div style="font-size:0.75rem; color:var(--amber); font-weight:bold; margin-bottom:8px;">⚠️ CRITICAL: Always switch your Blogger post editor to "HTML View" before pasting this!</div>
      <textarea id="codeOutput" readonly></textarea>
      <button type="button" class="btn btn-ghost btn-full" id="btnCopy" style="margin-top:8px;">📋 Copy code for Blogger</button>
      <div class="copy-confirm" id="copyConfirm">Copied — replace old block inside Blogger widget.</div>
    </div>
  </section>

  <!-- PUBLISHED LIST WORKSPACE CARD -->
  <section class="card" id="publishedNoticesCard">
    <h2>Published notices <span class="count" id="countTag">0</span></h2>
    <div id="noticeList"></div>
    <button type="button" class="btn btn-ghost btn-full" id="btnGetCode">📋 Get current code</button>
  </section>
</main>

<footer class="hint">
  Saved on <b>this device only</b>.<br>
  Copy it whole and replace the old code on Blogger each time.
</footer>

<div class="modal-bg" id="modalBg">
  <div class="modal-sheet">
    <div class="modal-head">
      <h3>How this looks on Blogger</h3>
      <button type="button" class="modal-close" id="modalClose">✕</button>
    </div>
    <div id="previewMount"></div>
  </div>
</div>

<script>
(function(){
  const STORAGE_KEY = 'noticeSystem_notifications_v2';
  const CONFIG_KEY = 'noticeSystem_widgetConfig_v7';
  const EXPIRE_DAYS = 100;
  const DAY_MS = 24*60*60*1000;

  let notices = [];
  let editingId = null;

  let widgetConfig = {
    mode: 'bubble', corner: 'bottom-right', offsetX: 18, offsetY: 18,
    tabSide: 'left', tabText: '📡 Notices', swipeSide: 'left',
    modalHeaderText: '📡 IMPORTANT NOTICES',
    modalBodyHtml: 'Welcome to the Los Star System. This is the official hub for planetary maps, lore, and artwork created by the community. Please review and accept to continue exploring.',
    modalCheckText: 'I understand and accept',
    modalBtnText: 'Continue',
    modalDelay: 0,
    modalWidth: 480,
    modalCheckRequired: 'true',
    customPriorityLabel: 'Custom',
    customPriorityColor: '#bb86fc'
  };

  try{ notices = JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; }catch(e){ notices = []; }
  try{ 
    const savedConfig = JSON.parse(localStorage.getItem(CONFIG_KEY));
    if(savedConfig) {
      widgetConfig = {...widgetConfig, ...savedConfig};
    }
  }catch(e){}

  const $ = s => document.querySelector(s);
  const editor = $('#editor');
  const termsEditor = $('#termsEditor');
  const imgInput = $('#imgInput');
  const termsImgInput = $('#termsImgInput');
  const noticeList = $('#noticeList');
  const countTag = $('#countTag');
  const codeBox = $('#codeBox');
  const codeOutput = $('#codeOutput');
  const loadOverlay = $('#loadOverlay');
  const loadText = $('#loadText');
  const copyConfirm = $('#copyConfirm');
  const fTitle = $('#fTitle'), fPriority = $('#fPriority'), fLink = $('#fLink'), fLinkLabel = $('#fLinkLabel');
  const fCustomLabel = $('#fCustomLabel'), fCustomColor = $('#fCustomColor'), customPriorityBlock = $('#customPriorityBlock');
  const composerTitle = $('#composerTitle');
  const btnPublish = $('#btnPublish');
  const btnCancelEdit = $('#btnCancelEdit');
  const composerCard = $('#composerCard');

  const fWidgetMode = $('#fWidgetMode'), fCorner = $('#fCorner'), fTabSide = $('#fTabSide'), fTabText = $('#fTabText'), fSwipeSide = $('#fSwipeSide');
  const fModalHeaderText = $('#fModalHeaderText'), fModalCheckText = $('#fModalCheckText'), fModalBtnText = $('#fModalBtnText'), fModalDelay = $('#fModalDelay'), lblDelayVal = $('#lblDelayVal');
  const fModalWidth = $('#fModalWidth'), lblWidthVal = $('#lblWidthVal');
  const fModalCheckRequired = $('#fModalCheckRequired');

  const cfgBubbleBlock = $('#cfgBubbleBlock'), cfgTabBlock = $('#cfgTabBlock'), cfgSwipeBlock = $('#cfgSwipeBlock'), cfgModalBlock = $('#cfgModalBlock');
  const btnStartDrag = $('#btnStartDrag'), dragSetupBubble = $('#drag-setup-bubble'), dragCoordHint = $('#dragCoordHint');

  fWidgetMode.value = widgetConfig.mode;
  fCorner.value = widgetConfig.corner;
  fTabSide.value = widgetConfig.tabSide;
  fTabText.value = widgetConfig.tabText;
  fSwipeSide.value = widgetConfig.swipeSide;
  fModalHeaderText.value = widgetConfig.modalHeaderText || '';
  fModalCheckRequired.value = widgetConfig.modalCheckRequired || 'true';
  termsEditor.innerHTML = widgetConfig.modalBodyHtml || '';
  fModalCheckText.value = widgetConfig.modalCheckText || '';
  fModalBtnText.value = widgetConfig.modalBtnText || '';
  fModalDelay.value = widgetConfig.modalDelay || 0;
  lblDelayVal.textContent = widgetConfig.modalDelay > 0 ? `${widgetConfig.modalDelay}s Locked` : '0s (Instant)';
  fModalWidth.value = widgetConfig.modalWidth || 480;
  lblWidthVal.textContent = `${fModalWidth.value}px`;
  fCustomLabel.value = widgetConfig.customPriorityLabel || 'Custom';
  fCustomColor.value = /^#[0-9a-fA-F]{6}$/.test(widgetConfig.customPriorityColor || '') ? widgetConfig.customPriorityColor : '#bb86fc';

  function updateModalCheckVisibility() {
    const isCheckRequired = widgetConfig.modalCheckRequired !== 'false';
    const checkTextLabel = fModalCheckText.closest('label');
    if (checkTextLabel) {
      checkTextLabel.style.display = isCheckRequired ? 'block' : 'none';
    }
  }

  function updateBlocksVisibility() {
    const isModal = widgetConfig.mode === 'modal';
    
    cfgBubbleBlock.style.display = widgetConfig.mode === 'bubble' ? 'flex' : 'none';
    cfgTabBlock.style.display = widgetConfig.mode === 'tab' ? 'flex' : 'none';
    cfgSwipeBlock.style.display = widgetConfig.mode === 'swipe' ? 'flex' : 'none';
    cfgModalBlock.style.display = isModal ? 'flex' : 'none';
    dragSetupBubble.classList.remove('active');

    const fieldsBlock = $('#noticeFieldsBlock');
    const pubCard = $('#publishedNoticesCard');

    updateModalCheckVisibility();

    if (isModal) {
      if(fieldsBlock) fieldsBlock.style.display = 'none';
      if(pubCard) pubCard.style.display = 'none';
      composerTitle.textContent = "Configure EULA Pop-Up";
      btnPublish.innerHTML = "💾 Save Terms Config";
      btnCancelEdit.style.display = 'none';
    } else {
      if(fieldsBlock) fieldsBlock.style.display = 'block';
      if(pubCard) pubCard.style.display = 'block';
      if(editingId) {
        composerTitle.textContent = "Edit notice";
        btnPublish.innerHTML = "💾 Save Changes";
        btnCancelEdit.style.display = 'inline-flex';
      } else {
        composerTitle.textContent = "Compose a notice";
        btnPublish.innerHTML = "📡 Publish";
        btnCancelEdit.style.display = 'none';
      }
    }
  }
  updateBlocksVisibility();

  function saveConfig(){ localStorage.setItem(CONFIG_KEY, JSON.stringify(widgetConfig)); }

  function showToast(message, type = 'info') {
    const container = $('#toast-container');
    const toast = document.createElement('div');
    toast.className = `toast ${type}`;
    toast.innerHTML = `<span class="toast-icon">${type === 'success' ? '✅' : '⚠️'}</span><span>${message}</span>`;
    container.appendChild(toast);
    setTimeout(() => toast.classList.add('show'), 50);
    setTimeout(() => {
      toast.classList.remove('show');
      setTimeout(() => toast.remove(), 300);
    }, 4000);
  }

  function save(){ localStorage.setItem(STORAGE_KEY, JSON.stringify(notices)); }
  function fmtDate(ts){ return new Date(ts).toLocaleString(undefined, {month:'short', day:'numeric', year:'numeric', hour:'2-digit', minute:'2-digit'}); }
  function esc(s){ return (s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
  function isValidHexColor(value){ return /^#[0-9a-fA-F]{6}$/.test((value || '').trim()); }
  function contrastText(hex){
    const c = (hex || '#bb86fc').slice(1);
    const r = parseInt(c.slice(0,2),16), g = parseInt(c.slice(2,4),16), b = parseInt(c.slice(4,6),16);
    return ((r*299 + g*587 + b*114) / 1000) > 160 ? '#03142b' : '#ffffff';
  }
  function priorityTagStyle(n){
    if(n && n.priority === 'custom'){
      const color = isValidHexColor(n.customColor) ? n.customColor : '#bb86fc';
      return 'background:' + color + ';color:' + contrastText(color) + ';';
    }
    return n && n.priority === 'alert' ? 'background:rgba(255,77,106,.18);color:#ff4d6a;' : n && n.priority === 'update' ? 'background:rgba(46,232,138,.16);color:#2ee88a;' : 'background:rgba(57,201,255,.16);color:#39c9ff;';
  }
  function priorityTagLabel(n){ return n && n.priority === 'custom' ? ((n.customLabel || 'Custom').trim().slice(0,30) || 'Custom') : ((n && n.priority) || 'standard'); }
  function updateCustomPriorityControls(){
    if(customPriorityBlock) customPriorityBlock.style.display = fPriority.value === 'custom' ? 'flex' : 'none';
  }

  fPriority.addEventListener('change', updateCustomPriorityControls);
  fCustomLabel.addEventListener('input', (e)=>{ widgetConfig.customPriorityLabel = e.target.value.trim().slice(0,30) || 'Custom'; saveConfig(); });
  fCustomColor.addEventListener('input', (e)=>{ if(isValidHexColor(e.target.value)){ widgetConfig.customPriorityColor = e.target.value; saveConfig(); } });
  updateCustomPriorityControls();

  fWidgetMode.addEventListener('change', (e)=>{ widgetConfig.mode = e.target.value; saveConfig(); updateBlocksVisibility(); });
  fCorner.addEventListener('change', (e)=>{ widgetConfig.corner = e.target.value; saveConfig(); });
  fTabSide.addEventListener('change', (e)=>{ widgetConfig.tabSide = e.target.value; saveConfig(); });
  fTabText.addEventListener('input', (e)=>{ widgetConfig.tabText = e.target.value; saveConfig(); });
  fSwipeSide.addEventListener('change', (e)=>{ widgetConfig.swipeSide = e.target.value; saveConfig(); });
  fModalHeaderText.addEventListener('input', (e)=>{ widgetConfig.modalHeaderText = e.target.value; saveConfig(); });
  fModalCheckRequired.addEventListener('change', (e)=>{ widgetConfig.modalCheckRequired = e.target.value; saveConfig(); updateModalCheckVisibility(); });
  termsEditor.addEventListener('input', () => { widgetConfig.modalBodyHtml = termsEditor.innerHTML; saveConfig(); });
  fModalCheckText.addEventListener('input', (e)=>{ widgetConfig.modalCheckText = e.target.value; saveConfig(); });
  fModalBtnText.addEventListener('input', (e)=>{ widgetConfig.modalBtnText = e.target.value; saveConfig(); });
  
  fModalDelay.addEventListener('input', (e)=>{
    widgetConfig.modalDelay = parseInt(e.target.value) || 0;
    lblDelayVal.textContent = widgetConfig.modalDelay > 0 ? `${widgetConfig.modalDelay}s Locked` : '0s (Instant)';
    saveConfig();
  });

  fModalWidth.addEventListener('input', (e)=>{
    widgetConfig.modalWidth = parseInt(e.target.value) || 480;
    lblWidthVal.textContent = `${fModalWidth.value}px`;
    saveConfig();
  });

  function toggleHeadingFormat() {
    termsEditor.focus();
    const selection = window.getSelection();
    if (!selection.rangeCount) return;
    
    let container = selection.getRangeAt(0).commonAncestorContainer;
    if (container.nodeType === 3) container = container.parentNode;

    let isH3 = false;
    let targetNode = container;
    while (targetNode && targetNode !== termsEditor) {
      if (targetNode.tagName === 'H3') { isH3 = true; break; }
      targetNode = targetNode.parentNode;
    }
    if (isH3) { document.execCommand('formatBlock', false, '<p>'); } else { document.execCommand('formatBlock', false, '<h3>'); }
    widgetConfig.modalBodyHtml = termsEditor.innerHTML;
    saveConfig();
  }

  $('#btnTermsH').addEventListener('click', toggleHeadingFormat);
  $('#btnTermsB').addEventListener('click', ()=>{ termsEditor.focus(); document.execCommand('bold'); widgetConfig.modalBodyHtml = termsEditor.innerHTML; saveConfig(); });
  $('#btnTermsS').addEventListener('click', ()=>{ termsEditor.focus(); document.execCommand('strikeThrough'); widgetConfig.modalBodyHtml = termsEditor.innerHTML; saveConfig(); });
  $('#btnTermsHR').addEventListener('click', ()=>{ termsEditor.focus(); document.execCommand('insertHorizontalRule'); widgetConfig.modalBodyHtml = termsEditor.innerHTML; saveConfig(); });
  $('#btnTermsLink').addEventListener('click', ()=>{
    const url = prompt('Paste URL Link:');
    if(url){ termsEditor.focus(); document.execCommand('createLink', false, url); widgetConfig.modalBodyHtml = termsEditor.innerHTML; saveConfig(); }
  });

  $('#btnTermsImg').addEventListener('click', () => termsImgInput.click());
  termsImgInput.addEventListener('change', e => {
    const file = e.target.files[0]; if(!file) return;
    const reader = new FileReader();
    reader.onload = ev => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        let width = img.width, height = img.height;
        if (width > 600) { height *= 600 / width; width = 600; }
        canvas.width = width; canvas.height = height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, width, height);

        const linkUrl = prompt('Enter a destination link URL for this image (optional, leave blank if none):');
        let htmlToInsert = '';
        const imgBase64 = canvas.toDataURL('image/jpeg', 0.72);
        
        if (linkUrl && linkUrl.trim() !== '') {
          htmlToInsert = `<a href="${linkUrl.trim()}" target="_blank" rel="noopener"><img src="${imgBase64}" style="max-width:100%; border-radius:8px; display:block; margin:6px 0;" /></a>`;
        } else {
          htmlToInsert = `<img src="${imgBase64}" style="max-width:100%; border-radius:8px; display:block; margin:6px 0;" />`;
        }
        
        termsEditor.focus();
        document.execCommand('insertHTML', false, htmlToInsert);
        widgetConfig.modalBodyHtml = termsEditor.innerHTML;
        saveConfig();
        showToast('Image inserted in terms successfully!', 'success');
      };
      img.src = ev.target.result;
    };
    reader.readAsDataURL(file);
  });

  $('#btnBold').addEventListener('click', ()=>{ editor.focus(); document.execCommand('bold'); });
  $('#btnHighlight').addEventListener('click', ()=>{ editor.focus(); document.execCommand('hiliteColor', false, '#ffbb4d'); });
  $('#btnLink').addEventListener('click', ()=>{
    const url = prompt('Link URL:');
    if(url){ editor.focus(); document.execCommand('createLink', false, url); }
  });
  $('#btnImg').addEventListener('click', ()=> imgInput.click());
  
  imgInput.addEventListener('change', e=>{
    const file = e.target.files[0]; if(!file) return;
    const reader = new FileReader();
    reader.onload = ev => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        let width = img.width, height = img.height;
        if (width > 750) { height *= 750 / width; width = 750; }
        canvas.width = width; canvas.height = height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, width, height);
        editor.focus();
        document.execCommand('insertImage', false, canvas.toDataURL('image/jpeg', 0.72));
      };
      img.src = ev.target.result;
    };
    reader.readAsDataURL(file);
  });

  $('#btnVid').addEventListener('click', ()=>{
    const url = prompt('Video URL:'); if(!url) return;
    editor.focus();
    let embed = `<a href="${url}" target="_blank">🎬 Watch video</a><br>`;
    const yt = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/))([\w-]{6,})/);
    if(yt) embed = `<iframe width="100%" height="200" style="border-radius:8px;border:none;" src="https://www.youtube.com/embed/${yt[1]}" allowfullscreen></iframe><br>`;
    document.execCommand('insertHTML', false, embed);
  });

  function startEdit(id) {
    const item = notices.find(n => String(n.id) === String(id));
    if (!item) return;

    editingId = item.id;
    if (widgetConfig.mode === 'modal') {
      widgetConfig.mode = 'bubble';
      fWidgetMode.value = 'bubble';
      saveConfig();
      updateBlocksVisibility();
    }

    composerTitle.textContent = "Edit notice";
    btnPublish.innerHTML = "💾 Save Changes";
    btnPublish.classList.remove('btn-primary');
    btnPublish.classList.add('btn-amber');
    btnCancelEdit.style.display = 'inline-flex';
    composerCard.style.borderColor = 'var(--amber)';
    composerCard.style.boxShadow = '0 0 16px rgba(255,187,77,0.25)';

    fTitle.value = item.title || '';
    fPriority.value = item.priority || 'standard';
    fCustomLabel.value = item.customLabel || widgetConfig.customPriorityLabel || 'Custom';
    fCustomColor.value = isValidHexColor(item.customColor) ? item.customColor : (isValidHexColor(widgetConfig.customPriorityColor) ? widgetConfig.customPriorityColor : '#bb86fc');
    updateCustomPriorityControls();
    editor.innerHTML = item.html || '';
    fLink.value = item.link || '';
    fLinkLabel.value = item.linkLabel || '';

    composerCard.scrollIntoView({ behavior: 'smooth' });
    editor.focus();
    showToast('Notice loaded into composer!', 'info');
  }

  function cancelEdit() {
    editingId = null;
    composerTitle.textContent = "Compose a notice";
    btnPublish.innerHTML = "📡 Publish";
    btnPublish.classList.add('btn-primary');
    btnPublish.classList.remove('btn-amber');
    btnCancelEdit.style.display = 'none';
    composerCard.style.borderColor = 'var(--line)';
    composerCard.style.boxShadow = '0 8px 24px rgba(0,0,0,.35)';

    fTitle.value = '';
    fPriority.value = 'standard';
    editor.innerHTML = '';
    fLink.value = '';
    fLinkLabel.value = '';
    codeBox.classList.remove('show');
  }

  btnCancelEdit.addEventListener('click', cancelEdit);

  let isDraggingSetup = false;
  let dragStartXSetup = 0;
  let dragStartYSetup = 0;

  function onDragStartSetup(clientX, clientY) {
    isDraggingSetup = true;
    dragStartXSetup = clientX - dragSetupBubble.offsetLeft;
    dragStartYSetup = clientY - dragSetupBubble.offsetTop;
  }

  function onDragMoveSetup(clientX, clientY) {
    if (!isDraggingSetup) return;
    let nx = clientX - dragStartXSetup;
    let ny = clientY - dragStartYSetup;
    nx = Math.max(0, Math.min(nx, window.innerWidth - 56));
    ny = Math.max(0, Math.min(ny, window.innerHeight - 56));
    dragSetupBubble.style.left = nx + 'px';
    dragSetupBubble.style.top = ny + 'px';
    updateDragCoords(nx, ny);
  }

  function onDragEndSetup() { isDraggingSetup = false; }

  dragSetupBubble.addEventListener('mousedown', e => {
    e.preventDefault();
    onDragStartSetup(e.clientX, e.clientY);
    const mouseMove = ev => onDragMoveSetup(ev.clientX, ev.clientY);
    const mouseUp = () => {
      onDragEndSetup();
      window.removeEventListener('mousemove', mouseMove);
      window.removeEventListener('mouseup', mouseUp);
    };
    window.addEventListener('mousemove', mouseMove);
    window.addEventListener('mouseup', mouseUp);
  });

  dragSetupBubble.addEventListener('touchstart', e => {
    if (e.touches.length > 0) { e.preventDefault(); onDragStartSetup(e.touches[0].clientX, e.touches[0].clientY); }
  }, { passive: false });

  dragSetupBubble.addEventListener('touchmove', e => {
    if (e.touches.length > 0) { e.preventDefault(); onDragMoveSetup(e.touches[0].clientX, e.touches[0].clientY); }
  }, { passive: false });

  dragSetupBubble.addEventListener('touchend', onDragEndSetup);

  function updateDragCoords(cx, cy) {
    const w = window.innerWidth, h = window.innerHeight;
    const isLeft = cx < (w / 2), isTop = cy < (h / 2);
    widgetConfig.corner = `${isTop ? 'top' : 'bottom'}-${isLeft ? 'left' : 'right'}`;
    fCorner.value = widgetConfig.corner;
    widgetConfig.offsetX = isLeft ? Math.round(cx) : Math.round(w - cx - 56);
    widgetConfig.offsetY = isTop ? Math.round(cy) : Math.round(h - cy - 56);
    dragCoordHint.textContent = `${widgetConfig.corner} (${widgetConfig.offsetX}px, ${widgetConfig.offsetY}px)`;
    saveConfig();
  }

  btnStartDrag.addEventListener('click', (e) => {
    e.preventDefault();
    const isActive = dragSetupBubble.classList.toggle('active');
    if (isActive) {
      const w = window.innerWidth, h = window.innerHeight;
      const isLeft = (widgetConfig.corner || 'bottom-right').includes('left');
      const isTop = (widgetConfig.corner || 'bottom-right').includes('top');
      let cx = isLeft ? widgetConfig.offsetX : w - widgetConfig.offsetX - 56;
      let cy = isTop ? widgetConfig.offsetY : h - widgetConfig.offsetY - 56;
      cx = Math.max(10, Math.min(cx, w - 65)); cy = Math.max(10, Math.min(cy, h - 65));
